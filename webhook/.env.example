# GitHub Personal Access Token mit Berechtigung: repo (für repository_dispatch)
# Token erstellen unter: https://github.com/settings/tokens
GITHUB_DISPATCH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Storyblok Webhook Secret (optional, aber empfohlen)
# Unter: Storyblok → Space Settings → Webhooks → Secret
STORYBLOK_WEBHOOK_SECRET=your_secret_here

# Kontaktformular Mail-Konfiguration (für webhook/contact.php)
# Empfängeradresse für eingehende Kontaktanfragen
CONTACT_RECIPIENT=info@example.com
# Absenderadresse (muss auf dem Server meist als gültige Domain-Mail existieren)
CONTACT_FROM=no-reply@example.com
# Redirect nach erfolgreichem Versand
CONTACT_SUCCESS_URL=/?contact=success
# Redirect bei Fehlern
CONTACT_ERROR_URL=/?contact=error

# Mosparo Spam-Schutz (optional, aber empfohlen)
MOSPARO_ENABLED=false
# Beispiel: https://mosparo.deinedomain.de/api/v1/verification/verify
MOSPARO_VERIFY_URL=
MOSPARO_API_KEY=
MOSPARO_API_SECRET=
