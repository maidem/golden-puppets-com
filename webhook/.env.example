# GitHub Personal Access Token mit Berechtigung: repo (für repository_dispatch)
# Token erstellen unter: https://github.com/settings/tokens
GITHUB_DISPATCH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Storyblok Webhook Secret (optional, aber empfohlen)
# Unter: Storyblok → Space Settings → Webhooks → Secret
STORYBLOK_WEBHOOK_SECRET=your_secret_here
