{
  "name": "nav_item",
  "display_name": "Navigation Item",
  "is_root": false,
  "is_nestable": true,
  "schema": {
    "label": {
      "type": "text",
      "display_name": "Label",
      "required": true,
      "pos": 0
    },
    "link": {
      "type": "multilink",
      "display_name": "Link",
      "required": false,
      "pos": 1
    },
    "section_id": {
      "type": "text",
      "display_name": "Section ID (Anker)",
      "description": "Optional. Beispiel: kontakt. Wenn gesetzt, springt der Link auf /#kontakt.",
      "pos": 2
    }
  }
}
