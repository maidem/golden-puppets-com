{
  "name": "contact_form",
  "display_name": "Kontaktformular",
  "is_root": false,
  "is_nestable": true,
  "schema": {
    "headline": {
      "type": "text",
      "display_name": "Überschrift",
      "pos": 0
    },
    "contact_title": {
      "type": "text",
      "display_name": "Kontakt-Spalte Titel",
      "default_value": "Kontakt",
      "pos": 1
    },
    "phone": {
      "type": "text",
      "display_name": "Telefonnummer",
      "pos": 2
    },
    "contact_email": {
      "type": "text",
      "display_name": "Kontakt E-Mail (Anzeige)",
      "pos": 3
    },
    "address": {
      "type": "textarea",
      "display_name": "Adresse",
      "pos": 4
    },
    "maps_url": {
      "type": "text",
      "display_name": "Google Maps URL",
      "pos": 5
    },
    "maps_label": {
      "type": "text",
      "display_name": "Maps Link Text",
      "default_value": "Route anzeigen",
      "pos": 6
    },
    "logo": {
      "type": "asset",
      "display_name": "Logo (links unten)",
      "filetypes": ["images"],
      "pos": 7
    },
    "action_url": {
      "type": "text",
      "display_name": "Form Action URL",
      "default_value": "/webhook/contact.php",
      "pos": 8
    },
    "recipient_email": {
      "type": "text",
      "display_name": "Empfänger E-Mail (intern)",
      "pos": 9
    },
    "submit_label": {
      "type": "text",
      "display_name": "Submit Button Text",
      "default_value": "Nachricht senden",
      "pos": 10
    },
    "privacy_label": {
      "type": "text",
      "display_name": "Datenschutz-Label",
      "default_value": "Ich habe die Datenschutzerklärung gelesen und akzeptiere sie.",
      "pos": 11
    },
    "privacy_link": {
      "type": "multilink",
      "display_name": "Link zur Datenschutzerklärung",
      "pos": 12
    },
    "success_message": {
      "type": "text",
      "display_name": "Erfolgsmeldung",
      "default_value": "Vielen Dank! Ihre Nachricht wurde gesendet.",
      "pos": 13
    },
    "section_id": {
      "type": "text",
      "display_name": "Section ID (Anker)",
      "description": "Optional. Beispiel: kontakt",
      "default_value": "kontakt",
      "pos": 14
    }
  }
}
