{
  "name": "contact_form",
  "display_name": "Kontaktformular",
  "is_root": false,
  "is_nestable": true,
  "schema": {
    "headline": {
      "type": "text",
      "display_name": "Überschrift",
      "pos": 0
    },
    "intro": {
      "type": "textarea",
      "display_name": "Einleitungstext",
      "pos": 1
    },
    "action_url": {
      "type": "text",
      "display_name": "Form Action URL",
      "default_value": "/webhook/contact.php",
      "pos": 2
    },
    "recipient_email": {
      "type": "text",
      "display_name": "Empfänger E-Mail (optional)",
      "pos": 3
    },
    "privacy_label": {
      "type": "text",
      "display_name": "Datenschutz-Label",
      "default_value": "Ich habe die Datenschutzerklärung gelesen und akzeptiere sie.",
      "pos": 4
    },
    "privacy_link": {
      "type": "multilink",
      "display_name": "Link zur Datenschutzerklärung",
      "pos": 5
    },
    "submit_label": {
      "type": "text",
      "display_name": "Submit Button Text",
      "default_value": "Senden",
      "pos": 6
    },
    "success_message": {
      "type": "text",
      "display_name": "Erfolgsmeldung",
      "default_value": "Vielen Dank! Ihre Nachricht wurde gesendet.",
      "pos": 7
    }
  }
}
