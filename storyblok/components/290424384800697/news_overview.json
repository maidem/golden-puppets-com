{
  "name": "news_overview",
  "display_name": "Aktuelles Übersicht",
  "is_root": false,
  "is_nestable": true,
  "preview_field": "headline",
  "schema": {
    "headline": {
      "type": "text",
      "display_name": "Überschrift",
      "default_value": "Aktuelles",
      "pos": 0
    },
    "folder_slug": {
      "type": "text",
      "display_name": "Ordner Pfad",
      "description": "Storyblok-Ordner mit den Artikeln, z.B. 'aktuelles'",
      "default_value": "aktuelles",
      "pos": 1
    },
    "section_id": {
      "type": "text",
      "display_name": "Section ID (Anker)",
      "description": "Optional. Beispiel: aktuelles",
      "default_value": "aktuelles",
      "pos": 2
    }
  }
}
